# AXIOM galaxy — runtime configuration (Vite env). Copy to `.env` to enable.
#
# LIVE mode: when VITE_VANTAGE_URL is set, AXIOM mirrors the real Ọmọ Kọ́dà
# population on the Vantage block mesh (read-only) — see VantageGraphEngine.ts.
# With nothing set, AXIOM runs the self-driving demo (MockGraphEngine).

# Base URL of the Vantage backend. Unset ⇒ demo mode.
VITE_VANTAGE_URL=https://your-vantage-host

# A read-only viewer agent key (X-Agent-Key) used to read the mesh roster/events.
VITE_VANTAGE_KEY=

# The block to mirror. Defaults to "default" (Ọmọ Kọ́dà's home block).
VITE_MESH_BLOCK=default
